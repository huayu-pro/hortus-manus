{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "noUncheckedIndexedAccess": false,
    "types": ["node"],
    "paths": {
      "@hortus/shared": ["../../packages/shared/src/index.ts"],
      "@hortus/art": ["../../packages/art/src/index.ts"]
    }
  },
  "include": ["src"]
}
